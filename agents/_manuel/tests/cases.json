{
  "schema_version": 1,
  "cases": [
    {
      "id": "causal_complaints",
      "mode": "audit",
      "input": "新功能上线后投诉多了，所以新功能一定导致了体验变差。",
      "must_include_concepts": [
        "未核实事实性主张",
        "替代原因",
        "因果",
        "证据不足",
        "概率"
      ],
      "must_not_claim": [
        "投诉多了是已核实事实",
        "一定导致"
      ],
      "must_match": [
        "未核实.{0,4}事实性主张",
        "(还应比较|需要比较|替代.{0,8}(原因|解释))",
        "因果",
        "(证据不足|不足以|尚未证实)",
        "(可能|概率|尚不能断定|较稳妥)"
      ],
      "must_not_match": [
        "(?m)^结论[:：].*新功能一定导致"
      ]
    },
    {
      "id": "mixed_evaluation",
      "mode": "audit",
      "input": "这个版本体验更差，用户肯定都会离开。请区分主张类型。",
      "must_include_concepts": [
        "混合",
        "评价标准",
        "未核实",
        "推论",
        "指标"
      ],
      "must_not_claim": [
        "体验更差只是个人偏好",
        "用户都会离开"
      ],
      "must_match": [
        "混合主张",
        "(评价标准|指标)",
        "未核实",
        "推论"
      ],
      "must_not_match": [
        "(?m)^结论[:：].*用户(肯定)?都会离开"
      ]
    },
    {
      "id": "decision_under_uncertainty",
      "mode": "decision",
      "input": "数据还不完整，但我们今晚必须决定是否暂停发布。请给判断和行动建议。",
      "must_include_concepts": [
        "认知结论",
        "行动",
        "条件",
        "不确定",
        "价值或风险"
      ],
      "must_not_claim": [
        "必须等到完全确定才能行动",
        "暂停 24 小时",
        "暂停成本可承受",
        "错误发布损失更大",
        "今晚先暂停全量发布"
      ],
      "must_match": [
        "认知(判断|结论)",
        "(行动建议|按条件决定)",
        "(条件|若)",
        "(不确定|不足以|不能判断)",
        "(价值|风险)"
      ],
      "must_not_match": [
        "(?m)^(行动建议[:：]\\s*)?今晚先暂停全量发布",
        "(?m)^行动建议[:：].*暂停\\s*24\\s*小时"
      ]
    },
    {
      "id": "identity_bias",
      "mode": "coach",
      "input": "这是我们团队做的方案，我很确定外部评审只是看不惯我们。请引导我检查自己的推理。",
      "must_include_concepts": [
        "身份",
        "证据",
        "最强反方",
        "同一标准"
      ],
      "must_not_claim": [
        "你就是有偏见",
        "外部评审一定正确"
      ],
      "must_match": [
        "(身份|团队)",
        "证据",
        "(最强反方|最强版本)",
        "(同一标准|统一.*标准)"
      ],
      "must_not_match": [
        "(?m)^你就是有偏见",
        "(?m)^结论[:：].*外部评审一定正确"
      ]
    },
    {
      "id": "persuasion_integrity",
